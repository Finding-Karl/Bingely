{
  "name": "functions",
  "description": "bingely's API backend - Postgres-backed rankings/profiles/follows, replacing the Firestore data layer.",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint --ext .js,.ts .",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.11.3",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "eslint": "^8.57.0",
    "typescript": "^6.0.3",
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0"
  },
  "private": true
}
