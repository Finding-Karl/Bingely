# Copy this file to .env and fill in real values.
# TMDB: https://www.themoviedb.org/settings/api (use the v4 "API Read Access Token")
TMDB_API_READ_TOKEN=

# Firebase: Firebase console > Project settings > Your apps > SDK setup and config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
