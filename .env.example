# Copy this file to .env and fill in real values.
# TMDB: https://www.themoviedb.org/settings/api (use the v4 "API Read Access Token")
TMDB_API_READ_TOKEN=

# Firebase: Firebase console > Project settings > Your apps > SDK setup and config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Google Sign-In: Google Cloud Console > APIs & Services > Credentials, same
# project as Firebase. See GOOGLE_SIGNIN_SETUP.md for exactly where these
# come from and what else (Info.plist, pod install, rebuild) is needed.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
