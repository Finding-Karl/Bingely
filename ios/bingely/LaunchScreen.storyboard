    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <!-- Same red as the app icon / Dashboard wordmark
                                 (#E5484D, theme.ts's light-mode `primary`).
                                 The "Bingely" text is a pre-rendered image
                                 (wordmark.imageset, baked from the same
                                 Playfair Display SemiBold Italic used on the
                                 Dashboard header) rather than a live UILabel
                                 with a custom fontDescription - iOS's launch
                                 screen renderer doesn't reliably load
                                 Info.plist-registered custom fonts before
                                 first paint, so a live label can silently
                                 fall back to the system font. Baking the text
                                 as an image sidesteps that entirely. -->
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="wordmark" translatesAutoresizingMaskIntoConstraints="NO" id="wmk-Iv-001">
                                <rect key="frame" x="77.5" y="297" width="220" height="73"/>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="Bcu-3y-fUS"/>
                        <color key="backgroundColor" red="0.89803921568627454" green="0.28235294117647058" blue="0.30196078431372547" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="wmk-Iv-001" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="centerY" id="ctr-y1"/>
                            <constraint firstItem="wmk-Iv-001" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="ctr-x1"/>
                            <constraint firstItem="wmk-Iv-001" firstAttribute="width" secondItem="wmk-Iv-001" secondAttribute="height" multiplier="3.0137" id="wmk-ratio"/>
                            <constraint firstItem="wmk-Iv-001" firstAttribute="width" constant="220" id="wmk-w"/>
                        </constraints>
                    </view>
